{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["pip_requirements", "github-actions"],
  "includePaths": ["requirements-ci-current.txt", ".github/workflows/tests.yml"],
  "pip_requirements": {
    "managerFilePatterns": ["/^requirements-ci-current\\.txt$/"]
  },
  "automerge": false,
  "prConcurrentLimit": 1,
  "prHourlyLimit": 1,
  "major": { "dependencyDashboardApproval": true },
  "packageRules": [
    {
      "description": "Python CI versions need coordinated PyTorch and native-engine validation",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["python"],
      "enabled": false
    }
  ],
  "pinDigests": false,
  "vulnerabilityAlerts": { "automerge": false }
}
